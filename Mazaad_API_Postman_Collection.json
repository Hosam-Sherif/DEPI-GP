      "name": "⚡ SignalR Hubs",
      "description": "WebSocket endpoints — NOT REST. Use JavaScript SignalR client.\nAuthentication: ?access_token=<JWT> in URL.",
      "item": [
        { "name": "📖 Auction Hub — Live Bidding",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/hubs/auction", "host": ["{{baseUrl}}"], "path": ["hubs","auction"] },
            "description": "URL: ws://localhost:5245/hubs/auction\n\n```javascript\nimport * as signalR from '@microsoft/signalr';\n\nconst connection = new signalR.HubConnectionBuilder()\n  .withUrl('http://localhost:5245/hubs/auction', {\n    accessTokenFactory: () => 'YOUR_companyAdminToken_or_companyUserToken'\n  })\n  .withAutomaticReconnect()\n  .build();\n\nawait connection.start();\n\n// Join auction room (listingId = 7)\nawait connection.invoke('JoinAuction', 7, 'Amino Company', false);\n\n// Listen for events\nconnection.on('AuctionJoined', data => console.log('Joined! Bids:', data.liveBids));\nconnection.on('BidPlaced', update => {\n  // Fires when ANYONE places a bid (via REST or Hub)\n  console.log('🔨 New bid:', update.newHighestBid, 'by', update.displayBidderName);\n  console.log('   bidId:', update.bidId, '| total bids:', update.totalBidCount);\n});\nconnection.on('BidRejected', err => console.error('Rejected:', err.message));\n\n// Place bid via hub (userId+companyId read from JWT automatically)\nawait connection.invoke('PlaceBid', {\n  listingId: 7,\n  bidAmountPerUnit: 350.00,\n  quantity: 10.0,\n  totalBidAmount: 3500.00,\n  isAnonymous: false\n});\n\n// Heartbeat every 30s\nsetInterval(() => connection.invoke('Heartbeat', 7), 30000);\n```"
          }
        },
        { "name": "📖 Bidding Hub — Simple Feed",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/hubs/bidding", "host": ["{{baseUrl}}"], "path": ["hubs","bidding"] },
            "description": "URL: ws://localhost:5245/hubs/bidding\n\n```javascript\nconst connection = new signalR.HubConnectionBuilder()\n  .withUrl('http://localhost:5245/hubs/bidding', {\n    accessTokenFactory: () => 'YOUR_companyToken'\n  })\n  .build();\n\nawait connection.start();\nawait connection.invoke('JoinAuction', 7); // listingId\n\n// Receive bid snapshot on join\nconnection.on('InitialBidState', bids => console.log('Current bids:', bids));\n\n// Receive live updates (fires on REST PlaceBid too)\nconnection.on('BidPlaced', update => {\n  console.log('Live update:', update);\n  // { listingId, bidId, displayBidderName, newHighestBid, totalBidCount, timestamp }\n});\n\nconnection.on('BidFailed', msg => console.error(msg));\n\n// Place bid via hub\nawait connection.invoke('PlaceBid', {\n  listingId: 7,\n  bidAmountPerUnit: 360.00,\n  quantity: 10.0,\n  totalBidAmount: 3600.00,\n  isAnonymous: false\n});\n```"
          }
        },
        { "name": "📖 Chat Hub — Real-Time Messages",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/hubs/chat", "host": ["{{baseUrl}}"], "path": ["hubs","chat"] },
            "description": "URL: ws://localhost:5245/hubs/chat\n\n```javascript\nconst CHANNEL_ID = 4; // from POST /api/Chat/start\n\nconst connection = new signalR.HubConnectionBuilder()\n  .withUrl('http://localhost:5245/hubs/chat')\n  .build();\n\nawait connection.start();\nawait connection.invoke('JoinChannel', CHANNEL_ID.toString());\n\n// Listen for messages (fires when REST SendMessage is called)\nconnection.on('ReceiveMessage', msg => {\n  console.log(`[${new Date(msg.sentAt).toLocaleTimeString()}]`,\n    `User ${msg.senderUserId}: ${msg.messageText}`);\n});\n\n// Send via hub\nawait connection.invoke('SendMessage', CHANNEL_ID, userId, 'Hello from SignalR!');\n// OR use REST: POST /api/Chat/{channelId}/messages\n```"
          }
        }
